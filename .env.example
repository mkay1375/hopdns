# Optional; copy to .env beside compose.yaml.
# Advertise the address clients can reach, not a Docker container address.
# Laptop/LAN: laptop's LAN IPv4. Server: server's public IPv4.
HOPDNS_PUBLIC_IPV4=
# Traffic is localhost-only until deliberately changed to a LAN address or 0.0.0.0.
# Restrict clients with an upstream/cloud firewall BEFORE exposing a server.
HOPDNS_TRAFFIC_BIND=127.0.0.1
HOPDNS_PANEL_PORT=48741
HOPDNS_DNS_PORT=53
HOPDNS_HTTP_PORT=80
HOPDNS_HTTPS_PORT=443
# After publication, pin a real released image or digest here.
# HOPDNS_IMAGE=ghcr.io/mkay1375/hopdns:v1.0.0
